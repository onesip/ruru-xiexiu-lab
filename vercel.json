{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {"source": "/app.js", "destination": "/app-wrapper.js"}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}
      ]
    }
  ]
}
